APP_ENV=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/nexcraft_salesos

# n8n
N8N_BASE_URL=http://localhost:5678

# External APIs - fill in your own keys, never commit real values
GOOGLE_PLACES_API_KEY=
# At least one AI provider key is required; more than one is recommended for automatic failover
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Free tier available from https://aistudio.google.com/apikey
GEMINI_API_KEY=

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

IMAP_HOST=
IMAP_PORT=993

# Required once this API is reachable beyond your own machine.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave blank to disable auth for local-only development.
API_KEY=
